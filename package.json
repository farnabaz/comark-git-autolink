{
  "name": "comark-git-autolink",
  "version": "0.1.0",
  "description": "A Comark plugin that turns git forge references such as #32, @user and commit SHAs into links. Works with GitHub and GitHub-compatible hosts.",
  "keywords": [
    "comark",
    "markdown",
    "mdc",
    "plugin",
    "git",
    "github",
    "autolink"
  ],
  "homepage": "https://github.com/farnabaz/comark-git-autolink#readme",
  "bugs": {
    "url": "https://github.com/farnabaz/comark-git-autolink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farnabaz/comark-git-autolink.git"
  },
  "author": "Farnabaz <farnabaz@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite --config vite.playground.config.ts",
    "bench": "tsx bench/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "comark": ">=0.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "comark": "^0.7.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  }
}
